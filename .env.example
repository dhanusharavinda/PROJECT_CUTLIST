# ─────────────────────────────────────────────────────────────────────────────
#  Cutlist: environment template
#  Copy this file to `.env.local` and fill in what you need.
#
#    cp .env.example .env.local        (macOS / Linux)
#    Copy-Item .env.example .env.local (Windows PowerShell)
#
#  NOTE: AI provider keys are optional here. Cutlist is designed so that each
#  workspace adds its own STT / LLM keys from inside the app
#  (Settings → AI providers). Keys entered in-app are encrypted at rest with
#  APP_ENCRYPTION_KEY and are never shared across workspaces.
#  Anything set below acts only as a fallback default for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# Public origin of this instance. Used for OAuth redirects and invite links.
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Signs session cookies.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-a-long-random-string

# 32 random bytes, base64. Encrypts provider API keys + OAuth tokens at rest
# (AES-256-GCM). Changing this makes previously stored keys unreadable.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-key

# ── Storage ─────────────────────────────────────────────────────────────────

# Where the SQLite database and uploaded media live. Relative to project root.
DATA_DIR=./data

# Max upload size in megabytes (source video files).
MAX_UPLOAD_MB=512

# Max size of a single clip Cutlist will copy out of Drive, in megabytes.
# Phone clips are large; this is deliberately higher than the upload limit.
IMPORT_MAX_MB=4096

# ── Optional: fallback AI providers ─────────────────────────────────────────
# Leave blank to force every workspace to bring its own keys via the UI.
# With no key anywhere, Cutlist falls back to its offline heuristic labeler so
# the product is still fully explorable.

# Speech-to-text. One of: openai | deepgram | assemblyai | groq
STT_PROVIDER=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=

# Large language model for auto-labelling and edit suggestions.
# One of: anthropic | openai | google | groq | openrouter
LLM_PROVIDER=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (sensible per-provider defaults are used otherwise)
LLM_MODEL=
STT_MODEL=

# ── Footage analysis ────────────────────────────────────────────────────────
# Shot detection, beat detection and thumbnails run through ffmpeg. The bundled
# binaries (npm install ffmpeg-static ffprobe-static) are found automatically.
# Set these only to point at your own build instead.
FFMPEG_PATH=
FFPROBE_PATH=

# ── Optional: Google Drive integration ──────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Enable the "Google Drive API" for the project.
# Authorised redirect URI must be exactly:
#   http://localhost:3000/api/integrations/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/drive/callback

# ── Optional: instance behaviour ────────────────────────────────────────────

# Set to "closed" to disable public sign-up (invite-only instance).
SIGNUP_MODE=open
